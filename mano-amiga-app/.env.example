# Puerto del front-service (el FRONT_PORT del .env del servidor).
# La IP se detecta sola: es la de la compu donde corrés "npx expo start".
EXPO_PUBLIC_API_PORT=8090

# Opcional: forzar una URL fija (por ejemplo, el servidor de producción).
# Si la ponés, se ignora la detección automática.
# EXPO_PUBLIC_API_URL=https://api.midominio.com/api/v1
