{
  "name": "mano-amiga-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de Mano Amiga (red segura). Express + MongoDB.",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/scripts/seed.js",
    "test": "jest --runInBand",
    "audit": "npm audit --omit=dev"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  }
}
