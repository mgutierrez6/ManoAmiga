# ------------------------------------------------------------------
# Mano Amiga · variables de entorno
# 1) Copiá este archivo como ".env" (en esta misma carpeta).
# 2) Completá los valores. El .env NUNCA se sube a Git (está en .gitignore).
# ------------------------------------------------------------------

NODE_ENV=development

# --- API (backend) ---
PORT=3000

# Desarrollo: la cadena de conexión de MongoDB Atlas (usuario con permiso readWrite SOLO sobre mano_amiga).
# Ejemplo: mongodb+srv://manoamiga_app:CONTRASEÑA@cluster0.xxxxx.mongodb.net/mano_amiga?retryWrites=true&w=majority
# Producción con Docker: mongodb://manoamiga_app:CONTRASEÑA@mongo:27017/mano_amiga?authSource=mano_amiga
MONGO_URI=

# Secretos: cada uno distinto y de al menos 32 caracteres. Generalos con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
QR_SECRET=

# Opcional: token de acceso de Expo si activan "Enhanced security for push notifications"
EXPO_ACCESS_TOKEN=

# --- Front-service (DMZ) ---
FRONT_PORT=8080
API_INTERNAL_URL=http://127.0.0.1:3000
RATE_LIMIT_POR_MINUTO=100
# Solo si hay un panel web (la app móvil no lo necesita). Ej: https://admin.midominio.com
CORS_ORIGINS=
# Solo en producción (certificado de Let's Encrypt):
# TLS_CERT_PATH=/etc/letsencrypt/live/TU_DOMINIO/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/TU_DOMINIO/privkey.pem

# --- Datos iniciales (npm run seed) — contraseñas de al menos 8 caracteres ---
SEED_ADMIN_EMAIL=admin@manoamiga.test
SEED_ADMIN_PASSWORD=
SEED_COORD_EMAIL=coord@manoamiga.test
SEED_COORD_PASSWORD=
SEED_JUDICIAL_EMAIL=judicial@manoamiga.test
SEED_JUDICIAL_PASSWORD=

# --- Solo para docker-compose (producción) ---
DOMINIO=
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=manoamiga_app
MONGO_APP_PASSWORD=
